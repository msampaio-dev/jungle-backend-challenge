PORT=3000

DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
DATABASE_TEST_URL=postgres://wagering:wagering@localhost:5433/wagering_test

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo

# Componentes em segundo plano (ligados por padrão; "false" desliga)
OUTBOX_RELAY_ENABLED=true
SQS_CONSUMER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true
# leitores do consumidor SQS em paralelo (wallets diferentes ao mesmo tempo)
SQS_CONSUMER_CONCURRENCY=5

# Quanto uma operação espera pelo lock de uma wallet antes de desistir (503 / retry)
WALLET_LOCK_TIMEOUT_MS=5000
# Quanto uma operação espera por uma conexão livre do pool antes de desistir (503 / retry)
DATABASE_ACQUIRE_TIMEOUT_MS=5000
# Limites de sessão no Postgres (só nas conexões da app; as migrations ficam sem)
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
