{
  "name": "jungle-backend-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed Wagering Processor — desafio técnico Jungle Gaming",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate:up": "bun run src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/database/migrate.ts down",
    "test": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1145.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}
